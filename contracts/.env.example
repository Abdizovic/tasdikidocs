# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file - it is already listed in .gitignore.

# RPC endpoint for the Polygon Amoy testnet (e.g. from Alchemy or Infura).
POLYGON_AMOY_RPC_URL=your-alchemy-or-infura-amoy-rpc-url

# Private key of the deployer/admin wallet used for Polygon Amoy deployments.
# Do NOT use a wallet that holds real funds. Prefix with 0x.
PRIVATE_KEY=your-wallet-private-key

# Polygonscan API key, used to verify deployed contract source code.
POLYGONSCAN_API_KEY=your-polygonscan-api-key
