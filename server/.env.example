# ---------------------------------------------------------------------------
# TasdikiDocs server environment configuration
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Supabase ---
# Project URL and keys from Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Pooled connection string (PgBouncer, port 6543) from
# Project Settings -> Database -> Connection string -> Transaction pooler.
# Only needed for running scripts/migrate.js — the running server itself
# talks to Supabase exclusively via SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
DATABASE_POOL_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres

# Personal access token for the Supabase Management API/CLI (from
# https://supabase.com/dashboard/account/tokens). Not read by the running
# server; only useful if you script CLI-based project management.
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# --- Email (Gmail SMTP, via nodemailer) ---
# Used to send the forgot-password OTP code. SMTP_GMAIL_USER must be the
# Gmail address the app password belongs to (Google Account -> Security ->
# 2-Step Verification -> App passwords).
SMTP_GMAIL_USER=your-gmail-address@gmail.com
SMTP_GMAIL_APP_PASSWORD=your-16-character-app-password

# --- Thirdweb / Polygon Amoy ---
# Used for on-chain certificate minting and IPFS storage (Thirdweb Storage
# covers IPFS — no separate Pinata account needed).
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
THIRDWEB_CLIENT_ID=your-thirdweb-client-id

# The single platform wallet that mints/revokes on-chain on behalf of every
# approved institution (see server/src/lib/contract.ts for why there isn't
# a per-institution wallet). Same key as contracts/.env's PRIVATE_KEY.
PLATFORM_WALLET_PRIVATE_KEY=your-wallet-private-key
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_CHAIN_ID=80002

# Filled in after deploying contracts/contracts/CertificateRegistry.sol
# (`npx hardhat run scripts/deploy.ts --network polygonAmoy` from contracts/).
CERTIFICATE_REGISTRY_ADDRESS=

# --- CORS ---
# Comma-separated list of allowed origins. Defaults to permissive ("*")
# in development if unset.
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
